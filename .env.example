# Copy to apps/web/.env.local and apps/indexer/.env. Never commit real values.

# PostgreSQL (Supabase or any Postgres). Tests use an embedded database and ignore this.
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require   # web: use the Supabase transaction pooler (port 6543); indexer: session pooler (5432) or 6543

# Base Mainnet JSON-RPC. Two independent providers; the indexer and quote API alternate between them.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL_FALLBACK=https://mainnet.base.org

# The first StockPair deployment on Base (packages/contracts/deployments/base.json), the one STOCK
# launched on. Public addresses, live for good. Keep these four naming it even once a list is set:
# the release that predates the list reads only them.
STOCKPAIR_FACTORY=0x888BC129704A4158C07614C234bb7EB8126aAD47
STOCKPAIR_HOOK=0xC81a728c6F4034e9249bB905f30E3013CA95E0Cc
STOCKPAIR_ROUTER=0x7Cb00fACE8a634FC0A2A953a562C15f3F67F96a8
STOCKPAIR_DEPLOY_BLOCK=50932769
# Every deployment, oldest first, once there is more than one. The list wins over the four keys above.
# Earlier factories and hooks stay live, so never drop an entry; scripts/apply-deployment.mjs appends.
# STOCKPAIR_DEPLOYMENTS=[{"factory":"0x888BC129704A4158C07614C234bb7EB8126aAD47","hook":"0xC81a728c6F4034e9249bB905f30E3013CA95E0Cc","router":"0x7Cb00fACE8a634FC0A2A953a562C15f3F67F96a8","deployBlock":50932769},{"factory":"0x...","hook":"0x...","router":"0x...","deployBlock":...}]

# Metadata pinning (Pinata). Only the web app needs this.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# Browser-visible values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STOCKPAIR_FACTORY=0x888BC129704A4158C07614C234bb7EB8126aAD47
NEXT_PUBLIC_STOCKPAIR_HOOK=0xC81a728c6F4034e9249bB905f30E3013CA95E0Cc
NEXT_PUBLIC_STOCKPAIR_ROUTER=0x7Cb00fACE8a634FC0A2A953a562C15f3F67F96a8
# The same list for the browser, with deployBlock included.
# NEXT_PUBLIC_STOCKPAIR_DEPLOYMENTS=
