# Copy to apps/web/.env.local and apps/indexer/.env. Never commit real values.

# PostgreSQL (Supabase or any Postgres). Tests use an embedded database and ignore this.
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Base Mainnet JSON-RPC. Two independent providers; the indexer and quote API alternate between them.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL_FALLBACK=https://mainnet.base.org

# Deployed StockPair contracts on Base (filled in by packages/contracts/script/Deploy.s.sol output).
STOCKPAIR_FACTORY=0x0000000000000000000000000000000000000000
STOCKPAIR_HOOK=0x0000000000000000000000000000000000000000
STOCKPAIR_ROUTER=0x0000000000000000000000000000000000000000
STOCKPAIR_DEPLOY_BLOCK=0

# Metadata pinning (Pinata). Only the web app needs this.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# Browser-visible values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STOCKPAIR_FACTORY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_STOCKPAIR_HOOK=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_STOCKPAIR_ROUTER=0x0000000000000000000000000000000000000000
