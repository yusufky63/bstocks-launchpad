# The alerts service reads .env and .env.local from its OWN directory, not the repo root,
# because pnpm runs it with apps/alerts as the working directory. The indexer works the same way.

# The same database the indexer writes.
DATABASE_URL=postgresql://...

# From BotFather. The bot only ever calls sendMessage: no webhook, no commands, no privacy setting.
TELEGRAM_ALERTS_TOKEN=

# The channel's numeric id, which survives a rename; @name works but breaks the day it changes.
#   curl -s "https://api.telegram.org/bot<TOKEN>/getChat?chat_id=@yourchannel"
# With this or the token unset the service logs that it is disabled and exits, which is a normal
# state for a machine that only runs the indexer.
TELEGRAM_ALERTS_CHANNEL_ID=

# Where the buttons point.
# The public https address only: it goes on every post's buttons, which Telegram refuses otherwise.
NEXT_PUBLIC_APP_URL=https://launchpad.basestocks.finance

# Renders every post to the log and sends nothing. The way to see what the channel would say
# before pointing it at the channel.
ALERTS_DRY_RUN=false

# A trade is posted when it clears this in USD, or this share of the token's own 24h volume.
ALERTS_MIN_TRADE_USD=500
ALERTS_MIN_TRADE_SHARE=0.15
# …but never below this, however quiet the day was. Without it a token doing $5 a day makes a
# $1 trade 20% of its volume, and every trade on a dead token is "large".
ALERTS_MIN_TRADE_FLOOR_USD=100

# Above this many postable alerts in one pass, they collapse into a single summary.
ALERTS_BACKLOG_LIMIT=8

ALERTS_POLL_MS=5000
ALERTS_HEALTH_PORT=8789
